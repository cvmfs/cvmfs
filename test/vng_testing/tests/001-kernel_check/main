#!/bin/bash

cvmfs_test_name="Test failing on v5.12"
cvmfs_test_suites="quick dummy"

cvmfs_run_test() {
  logfile=$1

  echo "Dummy test"
  kernel_version=$(uname -r)

    if [[ "$kernel_version" == *5.12* ]]; then
        echo "This test fails on kernel $kernel_version"
        return 1
    else
        echo "Kernel $kernel_version is fine"
        return 0
    fi

  return 1
}

