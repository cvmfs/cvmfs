#!/bin/bash
cvmfs_test_name="Repository gateway catalog removal recursion"
cvmfs_test_autofs_on_startup=false
cvmfs_test_suites="quick"

# This test covers the maximum recursion depth of the receiver upon deleting a nested catalog.
# upstream is of type GW


compare_file_checksum() {
    local file_name=$1
    local target_checksum=$2
    local checksum=$(md5sum $file_name | cut -d' ' -f1)
    echo "Checksum of $file_name is $checksum"
    if [ "$checksum" != "$target_checksum" ]; then
        echo "Checksum mismatch for $file_name. Expected $target_checksum. Found $checksum"
        return 1
    fi
}

check_recursion_depth() {
    local min_dir=$1
    local max_dir=$2
    local log_start=${3:-0}
    echo "  Checking receiver recursion depth"
    local debug_log="/var/log/cvmfs_receiver/debug.log"
    local directories
    directories=$(sudo tail -n +"$((log_start + 1))" "$debug_log" 2>/dev/null | grep "DiffRec: recursing into")
    # Check if the minimum depth directory was entered
    if [[ -n "$min_dir" ]]; then
        if [[ "$directories" != *"DiffRec: recursing into $min_dir"* ]]; then
            echo "  Receiver did not enter $min_dir"
            return 1
        fi
    else
        if [[ -z "$directories" ]]; then
            echo "  Receiver did not recurse into any directory"
            return 1
        fi
    fi
    # Check if the maximum depth directory was not entered
    if [[ "$directories" == *"DiffRec: recursing into $max_dir"* ]]; then
        echo "  Receiver unnecessarily recursed into $max_dir directory"
        return 2
    fi

    return 0
}

cleanup() {
    sudo mv /etc/cvmfs/gateway/user.json.orig /etc/cvmfs/gateway/user.json
}

cvmfs_run_test() {
    set_up_repository_gateway || return 1

    sudo cp /etc/cvmfs/gateway/user.json /etc/cvmfs/gateway/user.json.orig || return 2
    jq '.receiver_path = "/usr/bin/cvmfs_receiver_debug"' \
        /etc/cvmfs/gateway/user.json > user.json.new || return 3
    sudo mv user.json.new /etc/cvmfs/gateway/user.json || return 4
    trap cleanup EXIT HUP INT TERM || return 5
    restart_repository_gateway || return 6

    echo "  Checking transaction + publish"

    ## Transaction 1
    echo "  Starting transaction 1 (Creating a deep directory tree which is assigned to nested catalogs)"
    cvmfs_server transaction test.repo.org || return 7

    echo "  Create a deep directory hierarchy"
    mkdir -p /cvmfs/test.repo.org/a || return 8
    mkdir -p /cvmfs/test.repo.org/a/b || return 9
    echo "New file" > /cvmfs/test.repo.org/a/b/c || return 10
    touch /cvmfs/test.repo.org/a/.cvmfscatalog || return 11
    touch /cvmfs/test.repo.org/a/b/.cvmfscatalog || return 12

    echo "  Publishing changes 1"
    cvmfs_server publish -v test.repo.org || return 13
    cvmfs_server check -i test.repo.org || return 14

    echo "  Checking results 1"
    compare_file_checksum /cvmfs/test.repo.org/a/b/c f1885b1a57c71cacbd923fc5e9aefef3 || return 15


    ## Transaction 2
    echo "  Starting transaction 2 (Removing highest level nested catalog)"
    cvmfs_server transaction test.repo.org || return 16

    echo "  Remove the directory containing the highest level nested catalog"
    rm -rfv /cvmfs/test.repo.org/a || return 17

    echo "  Publishing changes 2"
    log_start=$(sudo wc -l /var/log/cvmfs_receiver/debug.log 2>/dev/null | awk '{print $1}' || echo 0)
    cvmfs_server publish -v test.repo.org || return 18
    cvmfs_server check -i test.repo.org || return 19

    check_recursion_depth "" "/a" "$log_start" || return 20


    ## Transaction 3
    echo "  Starting transaction 3 (Creating a deep directory tree which is assigned to nested catalogs)"
    cvmfs_server transaction test.repo.org || return 21

    echo "  Create a deep directory hierarchy"
    mkdir -p /cvmfs/test.repo.org/a || return 22
    mkdir -p /cvmfs/test.repo.org/a/b || return 23
    mkdir -p /cvmfs/test.repo.org/a/b/c || return 24
    echo "New file" > /cvmfs/test.repo.org/a/b/c/d || return 25
    touch /cvmfs/test.repo.org/a/b/.cvmfscatalog || return 26
    touch /cvmfs/test.repo.org/a/b/c/.cvmfscatalog || return 27

    echo "  Publishing changes 3"
    cvmfs_server publish -v test.repo.org || return 28
    cvmfs_server check -i test.repo.org || return 29

    echo "  Checking results 3"
    compare_file_checksum /cvmfs/test.repo.org/a/b/c/d f1885b1a57c71cacbd923fc5e9aefef3 || return 30

    ## Transaction 4
    echo "  Starting transaction 4 (Removing the highest directory)"
    cvmfs_server transaction test.repo.org || return 31

    echo "  Remove the highest directory"
    rm -rfv /cvmfs/test.repo.org/a || return 32

    echo "  Publishing changes 4"
    log_start=$(sudo wc -l /var/log/cvmfs_receiver/debug.log 2>/dev/null | awk '{print $1}' || echo 0)
    cvmfs_server publish -v test.repo.org || return 33
    cvmfs_server check -i test.repo.org || return 34

    check_recursion_depth "/a" "/a/b" "$log_start" || return 35

    ## Transaction 5
    echo "  Starting transaction 5 (Creating a deep directory tree which is assigned to nested catalogs)"
    cvmfs_server transaction test.repo.org || return 36

    echo "  Create a deep directory hierarchy"
    mkdir -p /cvmfs/test.repo.org/a || return 37
    mkdir -p /cvmfs/test.repo.org/a/b || return 38
    echo "New file" > /cvmfs/test.repo.org/a/b/c || return 39
    touch /cvmfs/test.repo.org/a/.cvmfscatalog || return 40
    touch /cvmfs/test.repo.org/a/b/.cvmfscatalog || return 41

    echo "  Publishing changes 5"
    cvmfs_server publish -v test.repo.org || return 42
    cvmfs_server check -i test.repo.org || return 43

    echo "  Checking results 5"
    compare_file_checksum /cvmfs/test.repo.org/a/b/c f1885b1a57c71cacbd923fc5e9aefef3 || return 44

    ## Transaction 6
    echo "  Starting transaction 6 (Manually removing a nested catalog)"
    cvmfs_server transaction test.repo.org || return 45

    echo "  Removing nested catalog in /a/b"
    rm -rfv /cvmfs/test.repo.org/a/b/.cvmfscatalog || return 46

    echo "  Publishing changes 6"
    log_start=$(sudo wc -l /var/log/cvmfs_receiver/debug.log 2>/dev/null | awk '{print $1}' || echo 0)
    cvmfs_server publish -v test.repo.org || return 47
    cvmfs_server check -i test.repo.org || return 48

    check_recursion_depth "" "/a" "$log_start" || return 49

    return 0
}
