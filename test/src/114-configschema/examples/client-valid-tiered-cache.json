{
  "CVMFS_USER": "cvmfs",
  "CVMFS_NFILES": 65536,
  "CVMFS_MOUNT_DIR": "/cvmfs",
  "CVMFS_RELOAD_SOCKETS": "/var/run/cvmfs",
  "CVMFS_CHECK_PERMISSIONS": "yes",
  "CVMFS_TIMEOUT": 5,
  "CVMFS_TIMEOUT_DIRECT": 10,
  "CVMFS_SERVER_URL": "http://cvmfs-stratum-one.cern.ch/cvmfs/atlas.cern.ch",
  "CVMFS_HTTP_PROXY": "http://ca-proxy.cern.ch:3128;DIRECT",
  "CVMFS_STRICT_MOUNT": "no",
  "CVMFS_SHARED_CACHE": "yes",
  "CVMFS_QUOTA_LIMIT": 4000,
  "CVMFS_CACHE_BASE": "/var/lib/cvmfs",
  "CVMFS_WORKSPACE": "/var/lib/cvmfs/workspace",
  "CVMFS_CACHE_PRIMARY": "hpc",
  "CVMFS_CACHE_hpc_TYPE": "tiered",
  "CVMFS_CACHE_hpc_UPPER": "mem",
  "CVMFS_CACHE_hpc_LOWER": "disk",
  "CVMFS_CACHE_hpc_LOWER_READONLY": "no",
  "CVMFS_CACHE_mem_TYPE": "ram",
  "CVMFS_CACHE_mem_SIZE": "50%",
  "CVMFS_CACHE_mem_MALLOC": "heap",
  "CVMFS_CACHE_disk_TYPE": "posix",
  "CVMFS_CACHE_disk_BASE": "/var/lib/cvmfs",
  "CVMFS_CACHE_disk_SHARED": "yes"
}
