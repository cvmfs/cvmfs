#!/bin/bash
source "$TEST_ROOT"/test_functions
set -euo pipefail
set -x

this_script_dir=$(dirname "$(readlink -f "$0")")
if ! [[ -v TEST_ROOT ]]; then
    TEST_ROOT=$(readlink -f "$this_script_dir/../..")
fi
(
	# no strict mode in this subshell
	apache_switch on
)

sudo touch /etc/fstab # It's missing in Almalinux 8 container
sudo cp -a /etc/fstab{,.orig}
sudo truncate --size=0 /etc/fstab

create_repo() {
	MOUNT_OPTS=$1
	EXTRA_CONFIG=$2
	export CVMFS_USE_FILE_CHUNKING=false
	sudo mv /etc/fstab{,.bkp}
	sudo cvmfs_server mkfs -o "$CVMFS_TEST_USER" "$CVMFS_TEST_REPO"

	export CVMFS_TEST_MOUNTPOINT=/cvmfs/$CVMFS_TEST_REPO
	cat "$CVMFS_TEST_MOUNTPOINT"/new_repository

	pgrep cvmfs2
	sudo umount /cvmfs/"$CVMFS_TEST_REPO"
	sudo umount /var/spool/cvmfs/"$CVMFS_TEST_REPO"/rdonly
	sudo sed -i /etc/fstab -e "s/,noauto /,simple_options_parsing,disable_watchdog,noauto,debug,$MOUNT_OPTS /"
	sudo mv /etc/fstab{,.new}
	cat /etc/fstab.new /etc/fstab.bkp | sudo tee /etc/fstab
	sudo systemctl daemon-reload
	sudo tee -a /etc/cvmfs/repositories.d/"$CVMFS_TEST_REPO"/client.conf <<-EOF
	CVMFS_HTTP_PROXY=DIRECT
	CVMFS_KCACHE_TIMEOUT=0
	CVMFS_MAX_TTL_SECS=1
	CVMFS_AUTO_UPDATE=yes
	CVMFS_DEBUGLOG=/var/log/$CVMFS_TEST_REPO.cvmfs-debug.log
	CVMFS_USYSLOG=/var/log/$CVMFS_TEST_REPO.cvmfs-usyslog.log
	CVMFS_QUOTA_LIMIT=-1
	$EXTRA_CONFIG
	EOF
	sudo tee -a /etc/cvmfs/repositories.d/"$CVMFS_TEST_REPO"/server.conf <<-EOF
	CVMFS_USE_FILE_CHUNKING=false
	EOF

	sudo mount  /var/spool/cvmfs/"$CVMFS_TEST_REPO"/rdonly

	if sudo grep -F 'FUSE: Passthrough disabled in this build.' /var/log/"$CVMFS_TEST_REPO".cvmfs-debug.log; then
		CVMFS_TIME_WARNING_FLAG=1
		echo 'Warning: FUSE Passthrough disabled in the build, likely because libfuse is older than 3.17. Test skipped.'
		sudo cvmfs_server rmfs -f "$CVMFS_TEST_REPO"
		exit 0
	fi

	sudo mount  /cvmfs/"$CVMFS_TEST_REPO"

	sudo -E cvmfs_server transaction "$CVMFS_TEST_REPO"
	echo HELLO > "$CVMFS_TEST_MOUNTPOINT"/hello.txt
	time dd status=progress bs=1M count=10 if=/dev/urandom of="$CVMFS_TEST_MOUNTPOINT"/big.bin
	pushd "$CVMFS_TEST_MOUNTPOINT"
	sha1sum * > CHECKSUMS
	popd

	time sudo -E cvmfs_server publish "$CVMFS_TEST_REPO"
	mount | grep "$CVMFS_TEST_REPO"
	cat "$CVMFS_TEST_MOUNTPOINT"/hello.txt
	grep HELLO "$CVMFS_TEST_MOUNTPOINT"/hello.txt

	if [[ -v DEBUG ]] ; then
		sudo umount /cvmfs/"$CVMFS_TEST_REPO"
		sudo umount /var/spool/cvmfs/"$CVMFS_TEST_REPO"/rdonly
		nohup sudo valgrind \
			--tool=memcheck \
			--log-file=/var/log/"$CVMFS_TEST_REPO".valgrind.log \
			--enable-debuginfod=yes \
			--leak-check=full \
			--show-leak-kinds=all \
			--track-origins=yes \
			--trace-children=yes \
			--track-fds=yes \
			--show-error-list=all \
			--read-var-info=yes \
			--gen-suppressions=all \
			\
			/usr/bin/cvmfs2 -f -o \
			allow_other,fsname="$CVMFS_TEST_REPO",config=/etc/cvmfs/repositories.d/"$CVMFS_TEST_REPO"/client.conf:/var/spool/cvmfs/"$CVMFS_TEST_REPO"/client.local,disable_watchdog,simple_options_parsing,grab_mountpoint,uid=0,gid=0"$MOUNT_OPTS" \
			"$CVMFS_TEST_REPO" /var/spool/cvmfs/"$CVMFS_TEST_REPO"/rdonly \
			&
		while ! grep /var/spool/cvmfs/"$CVMFS_TEST_REPO"/rdonly /proc/mounts; do
			sleep 1
		done
		sudo mount /cvmfs/"$CVMFS_TEST_REPO"
	fi

	touch /tmp/"$CVMFS_TEST_REPO".big.bin.read.begin
	time dd status=progress bs=512 if="$CVMFS_TEST_MOUNTPOINT"/big.bin of=/dev/null
	touch /tmp/"$CVMFS_TEST_REPO".big.bin.read.end
	DURATION=$(echo -e "scale=10\n $(date +%s.%N --reference=/tmp/"$CVMFS_TEST_REPO".big.bin.read.end) - $(date +%s.%N --reference=/tmp/"$CVMFS_TEST_REPO".big.bin.read.begin)\n" | bc -q )
	echo "$DURATION" > /tmp/"$CVMFS_TEST_REPO".big.bin.read.duration

	pushd "$CVMFS_TEST_MOUNTPOINT"
	touch /tmp/"$CVMFS_TEST_REPO".checksums.read.begin
	time parallel -N0 "sha1sum --check --status CHECKSUMS" ::: {1..100}
	touch /tmp/"$CVMFS_TEST_REPO".checksums.read.end
	popd
	DURATION=$(echo -e "scale=10\n $(date +%s.%N --reference=/tmp/"$CVMFS_TEST_REPO".checksums.read.end) - $(date +%s.%N --reference=/tmp/"$CVMFS_TEST_REPO".checksums.read.begin)\n" | bc -q )
	echo "$DURATION" > /tmp/"$CVMFS_TEST_REPO".checksums.read.duration
	sudo umount /cvmfs/"$CVMFS_TEST_REPO"
	sudo umount /var/spool/cvmfs/"$CVMFS_TEST_REPO"/rdonly
}

export CVMFS_TEST_REPO=test.repo.dumbdumb
create_repo '' ''
sudo grep -F 'FUSE: Passthrough enabled in build, available at runtime, but not enabled by the config option.' /var/log/test.repo.dumbdumb.cvmfs-debug.log
sudo cvmfs_server rmfs -f "$CVMFS_TEST_REPO"

export CVMFS_TEST_REPO=test.repo.passthru
create_repo ,fuse_passthrough ''
sudo grep -F 'FUSE: Passthrough enabled.' /var/log/test.repo.passthru.cvmfs-debug.log
sudo cvmfs_server rmfs -f "$CVMFS_TEST_REPO"

export CVMFS_TEST_REPO=test.repo.with-var
create_repo '' 'CVMFS_FUSE_PASSTHROUGH=on'
sudo grep -F 'FUSE: Passthrough enabled.' /var/log/test.repo.with-var.cvmfs-debug.log
sudo cvmfs_server rmfs -f "$CVMFS_TEST_REPO"

head /tmp/test.repo.{dumbdumb,passthru,with-var}.big.bin.read.duration
head /tmp/test.repo.{dumbdumb,passthru,with-var}.checksums.read.duration
