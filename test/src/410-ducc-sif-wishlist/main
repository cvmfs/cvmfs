#!/bin/bash
cvmfs_test_name="DUCC sif_input in wish lists"
cvmfs_test_autofs_on_startup=false
cvmfs_test_suites="ducc"

CVMFS_TEST410_SIF_SOURCE="docker://almalinux:9"
CVMFS_TEST410_WWW_DIR=/var/www/html/ducc-test-410
CVMFS_TEST410_URL=http://localhost/ducc-test-410
CVMFS_TEST410_PIN=sha256:4100000000000000000000000000000000000000000000000000000000000410

ducc_test_410_clean_up() {
  sudo cvmfs_server rmfs -f $CVMFS_TEST_REPO
  sudo rm -f $CVMFS_TEST410_WWW_DIR/image.sif
  sudo rmdir $CVMFS_TEST410_WWW_DIR
}

ducc_test_410_recipe() {
  echo "version: 1"
  echo "cvmfs_repo: $CVMFS_TEST_REPO"
  echo "sif_input:"
  for entry in "$@"; do
    echo "  - $entry"
  done
}

ducc_test_410_revision() {
  attr -qg revision /var/spool/cvmfs/$CVMFS_TEST_REPO/rdonly
}

# prints the image ID that sif/<name> points to
ducc_test_410_id() {
  basename "$(readlink /cvmfs/$CVMFS_TEST_REPO/sif/$1)"
}

cvmfs_run_test() {
  local scratch=$(pwd)
  trap ducc_test_410_clean_up EXIT HUP INT TERM

  local apptainer=$(command -v apptainer || command -v singularity)
  [ -n "$apptainer" ] || { echo "apptainer not available"; return 1; }

  echo "*** building SIF image ***"
  $apptainer build $scratch/image.sif $CVMFS_TEST410_SIF_SOURCE || return 2
  sudo mkdir -p $CVMFS_TEST410_WWW_DIR || return 3
  sudo cp $scratch/image.sif $CVMFS_TEST410_WWW_DIR/ || return 3

  echo "*** creating empty repo ***"
  create_empty_repo $CVMFS_TEST_REPO $CVMFS_TEST_USER || return 4
  local repo=/cvmfs/$CVMFS_TEST_REPO

  echo "*** a failing entry does not stop the others ***"
  ducc_test_410_recipe \
    "{source: $CVMFS_TEST410_URL/missing.sif, name: missing:1}" \
    "{source: $CVMFS_TEST410_URL/image.sif, name: alma:9}" \
    "{source: $CVMFS_TEST410_URL/image.sif, name: pinned:1, digest: $CVMFS_TEST410_PIN}" \
    > $scratch/recipe.yaml
  sudo cvmfs_ducc convert $scratch/recipe.yaml && return 5
  [ -d $repo/sif/alma:9/.singularity.d ] || return 6
  [ -L $repo/sif/missing:1 ] && return 6
  [ "$(ducc_test_410_id pinned:1)" = "${CVMFS_TEST410_PIN#sha256:}" ] || return 7
  local old_id=$(ducc_test_410_id alma:9)
  [ -f $repo/.sifinfo/${old_id:0:2}/$old_id.json ] || return 8

  echo "*** an unchanged wish list does not publish ***"
  ducc_test_410_recipe \
    "{source: $CVMFS_TEST410_URL/image.sif, name: alma:9}" \
    "{source: $CVMFS_TEST410_URL/image.sif, name: pinned:1, digest: $CVMFS_TEST410_PIN}" \
    > $scratch/recipe.yaml
  local rev_before=$(ducc_test_410_revision)
  [ -n "$rev_before" ] || return 9
  sudo cvmfs_ducc convert $scratch/recipe.yaml || return 10
  [ "$(ducc_test_410_revision)" = "$rev_before" ] || return 11

  echo "*** a rebuilt SIF is ingested and relinked ***"
  $apptainer build --force $scratch/image.sif $CVMFS_TEST410_SIF_SOURCE || return 12
  sudo cp $scratch/image.sif $CVMFS_TEST410_WWW_DIR/ || return 12
  sudo cvmfs_ducc convert $scratch/recipe.yaml || return 13
  local new_id=$(ducc_test_410_id alma:9)
  [ "$new_id" != "$old_id" ] || return 14
  [ "$(ducc_test_410_id pinned:1)" = "${CVMFS_TEST410_PIN#sha256:}" ] || return 15
  $apptainer exec $repo/sif/alma:9 cat /etc/os-release | grep -q AlmaLinux || return 16

  echo "*** garbage collection removes the replaced image and its provenance ***"
  sudo cvmfs_ducc gc --db-path $scratch/gc1.db $CVMFS_TEST_REPO || return 17
  [ -e $repo/.flat/${old_id:0:2}/$old_id ] && return 18
  [ -e $repo/.sifinfo/${old_id:0:2}/$old_id.json ] && return 18
  [ -d $repo/.flat/${new_id:0:2}/$new_id/.singularity.d ] || return 19
  [ -f $repo/.sifinfo/${new_id:0:2}/$new_id.json ] || return 19

  echo "*** a removed entry is collected after delete-sif ***"
  ducc_test_410_recipe \
    "{source: $CVMFS_TEST410_URL/image.sif, name: pinned:1, digest: $CVMFS_TEST410_PIN}" \
    > $scratch/recipe.yaml
  sudo cvmfs_ducc delete-sif $CVMFS_TEST_REPO alma:9 || return 20
  [ -L $repo/sif/alma:9 ] && return 21
  sudo cvmfs_ducc convert $scratch/recipe.yaml || return 22
  sudo cvmfs_ducc gc --db-path $scratch/gc2.db $CVMFS_TEST_REPO || return 23
  [ -e $repo/.flat/${new_id:0:2}/$new_id ] && return 24
  [ -e $repo/.sifinfo/${new_id:0:2}/$new_id.json ] && return 24
  local pin_id=${CVMFS_TEST410_PIN#sha256:}
  [ -d $repo/.flat/${pin_id:0:2}/$pin_id/.singularity.d ] || return 25
  [ -f $repo/.sifinfo/${pin_id:0:2}/$pin_id.json ] || return 25

  return 0
}
