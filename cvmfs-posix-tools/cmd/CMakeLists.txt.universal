# Symlink this file as CMakeLists.txt in the tool's sources dir,
# and add an add_subdirectory() line to cvmfs-posix-tools/CMakeLists.txt

get_filename_component(TOOL_NAME ${CMAKE_CURRENT_SOURCE_DIR} NAME)

add_custom_target(
  "${TOOL_NAME}_target" ALL
  DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/${TOOL_NAME}
)

file(GLOB_RECURSE TOOL_GO_SOURCES LIST_DIRECTORIES false ./*.go)

add_custom_command(
  OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/${TOOL_NAME}
  COMMAND ${GO_COMPILER} build -modfile=../../go.mod -o ${CMAKE_CURRENT_BINARY_DIR}/${TOOL_NAME} -ldflags='-X main.Version=${CernVM-FS_VERSION_STRING}' -gcflags='-N -l'
  COMMAND ${GO_COMPILER} test -c -modfile=../../go.mod -o ${CMAKE_CURRENT_BINARY_DIR}/${TOOL_NAME}.test -ldflags='-X main.Version=${CernVM-FS_VERSION_STRING}' -gcflags='-N -l'
  WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
  DEPENDS ${TOOL_GO_SOURCES}
  COMMENT "Build ${TOOL_NAME} using the Go Compiler"
)

install (
  PROGRAMS ${CMAKE_CURRENT_BINARY_DIR}/${TOOL_NAME}
  DESTINATION "${CMAKE_INSTALL_PREFIX}/bin"
)
